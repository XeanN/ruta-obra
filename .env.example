# Copia este archivo como .env.local y completa los valores (nunca los subas a git).
# En Vercel se cargan por entorno: `vercel env add NOMBRE production|preview|development`.

# Neon Postgres. Con pooling para la app; sin pooling para migraciones (drizzle-kit).
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# Cloudflare R2 (API compatible con S3). Token con "Object Read & Write" solo en el bucket.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="rutaobra-archivos"
R2_ENDPOINT="https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com"

# Better Auth. Secreto aleatorio (32 bytes en base64) y URL pública de la app.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Ingreso con Google (cliente OAuth de Google Cloud).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Enlaces de acceso por correo (Resend). Remitente de un dominio verificado.
RESEND_API_KEY=""
EMAIL_FROM="RutaObra <acceso@aliiatech.com>"

# Correo público de contacto para privacidad (se muestra en /privacidad).
NEXT_PUBLIC_CORREO_CONTACTO=""
